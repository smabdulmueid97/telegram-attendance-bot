# Get a token from @BotFather on Telegram, then paste it here.
BOT_TOKEN=

# Telegram user IDs of admins, comma-separated (find your ID via @userinfobot).
# Admins can run /employees, /report, /report_week, /leaves, /approve, /add_admin.
ADMIN_IDS=

# Check-ins after this time (HH:MM, 24h) count as late. Default 09:30.
LATE_AFTER=09:30

# Optional. If set, the bot uses a webhook at this public URL (e.g. https://my-bot.onrender.com).
# Leave empty for long polling (local dev / a plain server).
WEBHOOK_URL=

# Port for the health-check server (/health). Default 3000.
PORT=3000

# Optional. SQLite file path. Default: ./attendance.db
# DB_PATH=./attendance.db
